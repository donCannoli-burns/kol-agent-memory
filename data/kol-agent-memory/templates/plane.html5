<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><title>{{TITLE}}</title><style>:root{--bg:#061011;--panel:#0b1b1d;--line:#1c3a3e;--text:#d9f0ec;--muted:#71928f;--cyan:#53e5d5;--amber:#ffba62}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.55 ui-monospace,monospace}.wrap{max-width:980px;margin:auto;padding:26px}.card{border:1px solid var(--line);background:var(--panel);border-radius:14px;padding:17px;margin:12px 0}.k{font-size:10px;letter-spacing:.14em;color:var(--cyan)}.muted{color:var(--muted)}a{color:var(--cyan)}code,pre{background:#041012;border:1px solid var(--line);border-radius:7px;padding:2px 5px;overflow:auto}</style></head><body><main class="wrap"><div class="k">{{KICKER}}</div><h1>{{TITLE}}</h1><div class="card">{{BODY}}</div><div class="card"><b>Cross-index</b><p><a href="{{MASTER_URI}}">← LLM Memory Wiki</a></p><p class="muted">Path: <code>{{PATH}}</code></p></div></main></body></html>
